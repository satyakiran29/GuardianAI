<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_developer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="32dp"
    android:orientation="vertical">

    <!-- Contributor Header (Monogram + Details) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Monogram Avatar Box -->
        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_monogram_badge">

            <TextView
                android:id="@+id/tv_dev_monogram"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-black"
                android:textColor="#F97316"
                android:textSize="38sp"
                android:textStyle="bold"
                tools:text="P" />
        </FrameLayout>

        <!-- Name & Role -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_dev_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Pampana Satya Kiran" />

            <TextView
                android:id="@+id/tv_dev_role"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                tools:text="Lead Developer &amp; System Architect" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bento Action Row (3 Tiles) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/btn_bento_tile_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_bento_tile"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tv_bento_tile_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-medium"
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                tools:text="Website" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_bento_tile_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_bento_tile"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tv_bento_tile_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-medium"
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                tools:text="LinkedIn" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_bento_tile_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_bento_tile"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tv_bento_tile_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-medium"
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                tools:text="GitHub" />
        </FrameLayout>
    </LinearLayout>

    <!-- Dot Separator Line (like carousel indicator in inspiration) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <View
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_margin="3dp"
            android:background="@drawable/bg_circle_info" />

        <View
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_margin="3dp"
            android:background="@drawable/bg_circle_info" />

        <View
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_margin="3dp"
            android:background="@drawable/bg_circle_info" />

        <View
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_margin="3dp"
            android:background="@drawable/bg_circle_info" />

        <View
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_margin="3dp"
            android:background="@drawable/bg_circle_info" />
    </LinearLayout>
</LinearLayout>
