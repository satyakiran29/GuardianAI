<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_developer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#0D1322"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#1F293D"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Member Avatar in Pink Glow Chip -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_safety_chip_pink">

            <ImageView
                android:id="@+id/img_member_avatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:contentDescription="Avatar"
                android:src="@drawable/ic_avatar_male" />
        </FrameLayout>

        <!-- Member Info (Name + Role + Tagline) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_dev_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Pampana Satya Kiran" />

                <ImageView
                    android:id="@+id/iv_dev_link_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="Link"
                    android:src="@drawable/ic_open_in_new_pink"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_dev_role"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#A0AEC0"
                android:textSize="11sp"
                tools:text="Lead Developer &amp; System Architect" />

            <TextView
                android:id="@+id/tv_dev_tagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:textColor="#718096"
                android:textSize="10sp"
                tools:text="Building technology for a safer tomorrow." />
        </LinearLayout>

        <!-- Right Social Icons & Chevron -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Website / Globe -->
            <ImageView
                android:id="@+id/btn_dev_web"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:clickable="true"
                android:contentDescription="Website"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/ic_web_globe_vector"
                android:visibility="gone"
                app:tint="#A0AEC0"
                tools:visibility="visible" />

            <!-- GitHub -->
            <ImageView
                android:id="@+id/btn_dev_github"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:clickable="true"
                android:contentDescription="GitHub"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/ic_github_vector"
                android:visibility="gone"
                app:tint="#A0AEC0"
                tools:visibility="visible" />

            <!-- LinkedIn -->
            <ImageView
                android:id="@+id/btn_dev_linkedin"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:clickable="true"
                android:contentDescription="LinkedIn"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/ic_linkedin_vector"
                android:visibility="gone"
                app:tint="#A0AEC0"
                tools:visibility="visible" />

            <!-- Chevron Right -->
            <ImageView
                android:id="@+id/iv_dev_chevron"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="4dp"
                android:contentDescription="Details"
                android:src="@drawable/ic_chevron_right"
                app:tint="#718096" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
