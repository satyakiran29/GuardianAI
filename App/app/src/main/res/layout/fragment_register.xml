<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container_login"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    android:clipChildren="false"
    android:fitsSystemWindows="true"
    tools:context=".ui.fragment.RegisterFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="28dp"
            android:paddingBottom="36dp">

            <!-- ══════════════════════════════════════════════════
                 Header: Emblem & Brand Title
                 ══════════════════════════════════════════════════ -->
            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_auth_logo_glow">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_shield_heart_vector"
                    app:tint="#FF2E93" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:letterSpacing="0.03"
                android:text="Create Account"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Join the 24/7 AI-powered safety circle network"
                android:textColor="#94A3B8"
                android:textSize="13sp" />

            <!-- ══════════════════════════════════════════════════
                 Registration Form Card
                 ══════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#111622"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="#1E293B"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="22dp">

                    <!-- Full Name Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/et_full_name_layout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:animateLayoutChanges="true"
                        android:hint="@string/full_name"
                        android:textColorHint="#94A3B8"
                        app:boxBackgroundColor="#101726"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/selector_auth_input_stroke"
                        app:boxStrokeWidth="1.2dp"
                        app:boxStrokeWidthFocused="1.8dp"
                        app:endIconMode="clear_text"
                        app:endIconTint="#94A3B8"
                        app:hintTextColor="@color/selector_auth_input_hint"
                        app:startIconDrawable="@drawable/ic_name_small"
                        app:startIconTint="#94A3B8">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_full_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="textPersonName"
                            android:paddingVertical="13dp"
                            android:singleLine="true"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Email Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/et_email_layout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:animateLayoutChanges="true"
                        android:hint="@string/email"
                        android:textColorHint="#94A3B8"
                        app:boxBackgroundColor="#101726"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/selector_auth_input_stroke"
                        app:boxStrokeWidth="1.2dp"
                        app:boxStrokeWidthFocused="1.8dp"
                        app:endIconMode="clear_text"
                        app:endIconTint="#94A3B8"
                        app:hintTextColor="@color/selector_auth_input_hint"
                        app:startIconDrawable="@drawable/ic_email_small"
                        app:startIconTint="#94A3B8">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_email"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="textEmailAddress"
                            android:paddingVertical="13dp"
                            android:singleLine="true"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Phone Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/et_phone_layout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:animateLayoutChanges="true"
                        android:hint="@string/phone"
                        android:textColorHint="#94A3B8"
                        app:boxBackgroundColor="#101726"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/selector_auth_input_stroke"
                        app:boxStrokeWidth="1.2dp"
                        app:boxStrokeWidthFocused="1.8dp"
                        app:endIconMode="clear_text"
                        app:endIconTint="#94A3B8"
                        app:hintTextColor="@color/selector_auth_input_hint"
                        app:startIconDrawable="@drawable/ic_call_small"
                        app:startIconTint="#94A3B8">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_phone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="phone"
                            android:paddingVertical="13dp"
                            android:singleLine="true"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Role Selection Box -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_role_card_selector"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.05"
                            android:text="ACCOUNT ROLE"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <RadioGroup
                            android:id="@+id/rg_role"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/rb_role_user"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:buttonTint="#FF2E93"
                                android:checked="true"
                                android:text="🌸 Protected User"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp" />

                            <RadioButton
                                android:id="@+id/rb_role_guardian"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:buttonTint="#10B981"
                                android:text="🛡️ Guardian Unit"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp" />
                        </RadioGroup>
                    </LinearLayout>

                    <!-- Password Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/et_password_layout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:animateLayoutChanges="true"
                        android:hint="@string/password"
                        android:textColorHint="#94A3B8"
                        app:boxBackgroundColor="#101726"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/selector_auth_input_stroke"
                        app:boxStrokeWidth="1.2dp"
                        app:boxStrokeWidthFocused="1.8dp"
                        app:endIconMode="password_toggle"
                        app:endIconTint="#94A3B8"
                        app:hintTextColor="@color/selector_auth_input_hint"
                        app:startIconDrawable="@drawable/ic_password_small"
                        app:startIconTint="#94A3B8">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="textPassword|textNoSuggestions"
                            android:paddingVertical="13dp"
                            android:singleLine="true"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Confirm Password Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/et_confirm_password_layout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:animateLayoutChanges="true"
                        android:hint="@string/confirm_password"
                        android:textColorHint="#94A3B8"
                        app:boxBackgroundColor="#101726"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/selector_auth_input_stroke"
                        app:boxStrokeWidth="1.2dp"
                        app:boxStrokeWidthFocused="1.8dp"
                        app:endIconMode="password_toggle"
                        app:endIconTint="#94A3B8"
                        app:hintTextColor="@color/selector_auth_input_hint"
                        app:startIconDrawable="@drawable/ic_password_small"
                        app:startIconTint="#94A3B8">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_confirm_password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="textPassword|textNoSuggestions"
                            android:paddingVertical="13dp"
                            android:singleLine="true"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Register Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_register"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_auth_btn_primary"
                        android:text="@string/btn_register"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="15.5sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null"
                        app:cornerRadius="14dp"
                        app:elevation="3dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════════════════
                 Bottom Navigation Link (Back to Login)
                 ══════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/already_have_account"
                    android:textColor="#94A3B8"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btn_login"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp"
                    android:text="@string/sign_in"
                    android:textColor="#FF70B5"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>