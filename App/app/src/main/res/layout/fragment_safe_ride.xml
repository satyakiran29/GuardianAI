<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:fitsSystemWindows="true"
    tools:context=".ui.fragment.SafeRideFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="50dp">

            <!-- Hero Banner Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/item_background_material"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/container"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="LIVE PROTOTYPE"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Rapido Safe Escort"
                            android:textColor="@color/text_color_secondary"
                            android:textSize="13sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tv_shield_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#1510B981"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="🛡️ Shield Ready"
                            android:textColor="#10B981"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        style="@style/TextAppearance.Material3.HeadlineSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Guardian Ride &amp; Escort"
                        android:textColor="@color/text_color_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextAppearance.Material3.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Verified 2-Wheeler &amp; 4-Wheeler safety escorts with live telemetry tracking."
                        android:textColor="@color/text_color_secondary" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Interactive Escort Leaflet Map Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeColor="#22FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="280dp">

                        <android.webkit.WebView
                            android:id="@+id/web_view_escort_map"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <ProgressBar
                            android:id="@+id/pb_map_loading"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:indeterminateTint="?attr/colorPrimary" />

                        <!-- Floating Live Telemetry Badge -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|start"
                            android:layout_margin="12dp"
                            android:background="#D0020617"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/bg_circle_icon"
                                android:backgroundTint="#10B981" />

                            <TextView
                                android:id="@+id/tv_pilots_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="3 Guardian Pilots Patrolling Nearby"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Floating Recenter Button -->
                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                            android:id="@+id/fab_recenter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="12dp"
                            android:contentDescription="Recenter Map"
                            app:backgroundTint="#0F172A"
                            app:elevation="4dp"
                            app:fabCustomSize="42dp"
                            app:srcCompat="@drawable/ic_location_on"
                            app:tint="?attr/colorPrimary" />

                    </FrameLayout>

                    <!-- Destination Quick Selection Bar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#0A0F1D"
                        android:orientation="vertical"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="10dp">

                        <TextView
                            android:id="@+id/tv_selected_destination"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📍 Destination: GMR Varalakshmi CARE Hospital"
                            android:textColor="@color/text_color_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:scrollbars="none">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/chip_dest_hospital"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/container"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="5dp"
                                    android:text="🏥 GMR Care Hospital"
                                    android:textColor="?attr/colorPrimary"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/chip_dest_station"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:background="@drawable/item_background_material"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="5dp"
                                    android:text="🚉 Cheepurupalli Stn"
                                    android:textColor="@color/text_color_secondary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/chip_dest_campus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:background="@drawable/item_background_material"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="5dp"
                                    android:text="🏫 GMRIT Main Gate"
                                    android:textColor="@color/text_color_secondary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/chip_dest_market"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:background="@drawable/item_background_material"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="5dp"
                                    android:text="🛍️ Santha Bazar"
                                    android:textColor="@color/text_color_secondary"
                                    android:textSize="11sp" />

                            </LinearLayout>
                        </HorizontalScrollView>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Active Escort HUD (Hidden until ride requested) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_active_escort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:strokeColor="#10B981"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#0C1322"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header Status Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_escort_status_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#2010B981"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="⚡ CAPTAIN ASSIGNED • 2 MINS AWAY"
                            android:textColor="#10B981"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tv_escort_otp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#203B82F6"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="START OTP: 8419"
                            android:textColor="#60A5FA"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Pilot Profile Details -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_circle_icon"
                            android:backgroundTint="#1E293B"
                            android:padding="10dp"
                            android:src="@drawable/ic_ride_bike"
                            app:tint="#10B981" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_pilot_name"
                                style="@style/TextAppearance.Material3.TitleMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Captain Priya V. (Verified Female Pilot)"
                                android:textColor="@color/text_color_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_pilot_vehicle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="TVS Jupiter • AP 39 BK 9821 • ⭐ 4.9 (1,420 Escorts)"
                                android:textColor="@color/text_color_secondary"
                                android:textSize="12sp" />

                        </LinearLayout>
                    </LinearLayout>

                    <!-- Telemetry Live Stream Indicators -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="#15FFFFFF"
                        android:orientation="horizontal"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/tv_telemetry_speed"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="🚀 Speed: 26 km/h"
                            android:textColor="#94A3B8"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_telemetry_drift"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="🛡️ Drift: 0m (On-Road)"
                            android:textColor="#10B981"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_telemetry_police"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="📡 Police Beat: Link"
                            android:textColor="#60A5FA"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Quick Action Buttons for Active Ride -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_call_pilot"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:paddingHorizontal="4dp"
                            android:text="📞 Call Pilot"
                            android:textSize="12sp"
                            app:strokeColor="#3B82F6" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_share_telemetry"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:paddingHorizontal="4dp"
                            android:text="🔗 Share GPS"
                            android:textSize="12sp"
                            app:strokeColor="?attr/colorPrimary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_sos_intercept"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:backgroundTint="#EF4444"
                            android:paddingHorizontal="4dp"
                            android:text="🚨 SOS"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btn_cancel_escort"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="10dp"
                        android:text="Cancel Escort Request"
                        android:textColor="#EF4444"
                        android:textSize="12sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Escort Service Options (3 Rapido Style Cards) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="8dp"
                android:text="Choose Escort Protection Type"
                android:textColor="@color/text_color_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Option 1: Solo Bike Escort -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_opt_bike"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/item_background_material"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_icon"
                        android:backgroundTint="#1510B981"
                        android:padding="8dp"
                        android:src="@drawable/ic_ride_bike"
                        app:tint="#10B981" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Guardian Bike Escort"
                            android:textColor="@color/text_color_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Female / Police-Cleared Pilot • Dual Helmet"
                            android:textColor="@color/text_color_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹49"
                            android:textColor="@color/text_color_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚡ 2 min away"
                            android:textColor="#10B981"
                            android:textSize="11sp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Option 2: Shadow Commute Shield -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_opt_shadow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="#20FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/item_background_material"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_icon"
                        android:backgroundTint="#153B82F6"
                        android:padding="8dp"
                        android:src="@drawable/ic_shield_safe_mode"
                        app:tint="#3B82F6" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Shadow Commute Shield"
                            android:textColor="@color/text_color_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pilot rides behind you with strobe &amp; cam"
                            android:textColor="@color/text_color_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹39"
                            android:textColor="@color/text_color_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚡ 3 min away"
                            android:textColor="#3B82F6"
                            android:textSize="11sp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Option 3: Guardian Safe Cab -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_opt_cab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="#20FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/item_background_material"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_icon"
                        android:backgroundTint="#15F59E0B"
                        android:padding="8dp"
                        android:src="@drawable/ic_shield"
                        app:tint="#F59E0B" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Guardian Safe Cab (4W)"
                            android:textColor="@color/text_color_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dedicated partition, panic lock, EV comfort"
                            android:textColor="@color/text_color_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹119"
                            android:textColor="@color/text_color_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚡ 5 min away"
                            android:textColor="#F59E0B"
                            android:textSize="11sp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Main Request Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_request_escort"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:minHeight="@dimen/button_height"
                android:text="⚡ Request Instant Safety Escort"
                android:textSize="16sp"
                app:cornerRadius="@dimen/component_corner_radius" />

            <!-- Original Feature Details Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="Integrated Safety Protection"
                android:textColor="@color/text_color_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Feature 1 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="4dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp">

                <LinearLayout
