<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="#6366F1"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_safety_timer"
                        app:tint="#6366F1" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.Material3.TitleLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/safety_timer_title"
                            android:textColor="@color/text_color_primary"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/TextAppearance.Material3.BodySmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Auto-SOS if you don't check in"
                            android:textColor="@color/text_color_secondary" />
                    </LinearLayout>

                    <!-- Shield badge -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#1A6366F1"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="💀 DMS"
                        android:textColor="#6366F1"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/safety_timer_desc"
                    android:textColor="@color/text_color_secondary" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Countdown Display Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:id="@+id/tv_timer_status"
                    style="@style/TextAppearance.Material3.LabelLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Set duration, then arm the switch"
                    android:textColor="#6366F1"
                    android:textStyle="bold" />

                <!-- Digital Time Countdown -->
                <TextView
                    android:id="@+id/tv_countdown_digits"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="16dp"
                    android:fontFamily="sans-serif-black"
                    android:text="30:00"
                    android:textColor="@color/text_color_primary"
                    android:textSize="64sp" />

                <!-- Selected duration label -->
                <TextView
                    android:id="@+id/tv_selected_duration"
                    style="@style/TextAppearance.Material3.LabelMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Duration: 30 min"
                    android:textColor="@color/text_color_secondary" />

                <!-- ══════════════════════════════════════════════════
                     Duration Slider  (1 min → 180 min = 3 hr)
                     ══════════════════════════════════════════════════ -->
                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_duration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:stepSize="1"
                    android:value="30"
                    android:valueFrom="1"
                    android:valueTo="180"
                    app:labelBehavior="floating"
                    app:thumbColor="#6366F1"
                    app:thumbRadius="10dp"
                    app:trackColorActive="#6366F1"
                    app:trackColorInactive="#334155"
                    app:trackHeight="4dp" />

                <!-- Range labels -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="1 min"
                        android:textColor="@color/text_color_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="1 hr"
                        android:textColor="@color/text_color_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="3 hr"
                        android:textColor="@color/text_color_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- ══════════════════════════════════════════════════
                     Quick-pick preset chips
                     ══════════════════════════════════════════════════ -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_5m"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5m" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_15m"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/safety_timer_15m" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_30m"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/safety_timer_30m" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_45m"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/safety_timer_45m" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_60m"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/safety_timer_60m" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_90m"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.5h" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_120m"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2h" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_180m"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3h" />

                </com.google.android.material.chip.ChipGroup>

                <!-- Start / Cancel Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_toggle_timer"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_weight="1"
                        android:text="@string/safety_timer_start_btn"
                        app:cornerRadius="16dp"
                        app:backgroundTint="#6366F1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_check_in_safe"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/safety_timer_check_in_btn"
                        android:visibility="gone"
                        app:backgroundTint="#10B981"
                        app:cornerRadius="16dp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- How it works info card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#0F1A2B"
            app:cardCornerRadius="16dp"
            app:strokeColor="#334155"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ℹ️  How Dead Man's Switch works"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.4"
                    android:text="1. Set duration (1 min – 3 hrs) using slider or quick chips\n2. Tap Arm Switch — a persistent notification appears\n3. You can close the app — countdown runs in background\n4. At 30s remaining, an urgent notification fires\n5. If you don't tap ✅ I'm Safe — SOS auto-triggers"
                    android:textColor="#64748B"
                    android:textSize="12sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
