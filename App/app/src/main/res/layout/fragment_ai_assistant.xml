<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_ai_assistant_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0B0E"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context=".ui.fragment.AiAssistantFragment">

    <!-- Pinned Top Navigation Bar -->
    <LinearLayout
        android:id="@+id/card_ai_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#13151B"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_info"
            android:src="@drawable/ic_arrow_back"
            app:tint="#FFFFFF"
            android:contentDescription="Back" />

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_circle_info">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_ai_assistant"
                app:tint="?attr/themeAccent"
                android:contentDescription="AI Assistant" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_assistant_title"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:src="@drawable/ic_badge_online_green"
                    android:contentDescription="Online status" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Online • 24/7 Intelligence Engine"
                    android:textColor="#34D399"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_clear_chat"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_info"
            android:src="@drawable/ic_remove"
            app:tint="#94A3B8"
            android:contentDescription="Clear Conversation" />
    </LinearLayout>

    <!-- Chat Messages Scroll Area -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_ai_chat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/layout_messages_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Initial AI Greeting Message Card -->
            <LinearLayout
                android:id="@+id/card_initial_greeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="36dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_card_safety_dark"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- AI Message Header -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_shield_check_vector"
                        app:tint="?attr/themeAccent"
                        android:contentDescription="Shield" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="GuardianAI Intelligence"
                        android:textColor="?attr/themeAccent"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_monogram_badge"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="Assistant"
                        android:textColor="#34D399"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_greeting_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hello! I am your GuardianAI Safety Intelligence Assistant.\n\nI provide immediate step-by-step guidance if you feel in danger, explain self-defense tactics, guide you on safe night transit, and clarify your legal rights. Tap any quick option below or ask me anything!"
                    android:textColor="#F8FAFC"
                    android:textSize="14.5sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Container: Quick Chips + Input Bar -->
    <LinearLayout
        android:id="@+id/layout_quick_and_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#13151B"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- Horizontal Scroll of Quick Prompts -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_q1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_monogram_badge"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="I feel I am being followed"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chip_q2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_monogram_badge"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="Safety tips for night cab"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chip_q3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_monogram_badge"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="Key self-defense moves"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chip_q4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_monogram_badge"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="My legal rights in public"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Message Input Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_ai_prompt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_card_safety_dark"
                android:hint="@string/ai_assistant_prompt_hint"
                android:textColor="#FFFFFF"
                android:textColorHint="#94A3B8"
                android:textSize="14sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:maxLines="3"
                android:inputType="textCapSentences|textMultiLine" />

            <ImageButton
                android:id="@+id/fab_send_ai"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_circle_info"
                android:src="@drawable/ic_send"
                app:tint="?attr/themeAccent"
                android:contentDescription="Send" />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
