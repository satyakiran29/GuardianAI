<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Frosted translucent glass dock with rounded top corners for GuardianAI -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="33dp" />
            <gradient
                android:angle="90"
                android:startColor="#E60E101A"
                android:centerColor="#D9141724"
                android:endColor="#CC181C2C"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
