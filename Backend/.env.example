# Django Backend Configuration
DJANGO_SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*

# Supabase PostgreSQL Cloud Database (IPv4 Pooler recommended for Render & Cloud)
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Supabase API (HTTPS REST & Realtime Cloud Sync)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-publishable-key-here

# Email Configuration (Gmail SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-16-character-app-password
DEFAULT_FROM_EMAIL=GuardianAI Safety <your-email@gmail.com>

# Google Apps Script HTTPS Relay (Port 443 - Bypasses Render's SMTP block 100%)
GMAIL_WEBHOOK_URL=https://script.google.com/macros/s/your-script-id/exec

SEED_DEMO_DATA=false
