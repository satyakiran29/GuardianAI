<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_darkest">

    <!-- Top Action Bar / Header -->
    <LinearLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/bg_dark"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:elevation="4dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_shield_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GuardianAI"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinner_city_selector"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:background="@null"
                android:overlapAnchor="false" />
        </LinearLayout>

        <!-- Language Switcher Button -->
        <ImageButton
            android:id="@+id/btn_header_language"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/badge_safe"
            android:src="@drawable/ic_globe"
            android:contentDescription="Select Language (English / Hindi / Telugu)" />

        <!-- Widgets Gallery Button -->
        <ImageButton
            android:id="@+id/btn_header_widgets"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/badge_safe"
            android:src="@drawable/ic_nav_dashboard"
            android:tint="@color/primary"
            android:contentDescription="Anify Widgets Gallery" />

        <!-- Check Update Button -->
        <ImageButton
            android:id="@+id/btn_header_update"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/badge_moderate"
            android:src="@drawable/ic_refresh"
            android:tint="@color/risk_moderate"
            android:contentDescription="Check for Updates" />

        <!-- Voice Detection Toggle Button -->
        <ImageButton
            android:id="@+id/btn_toggle_voice_trigger"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/badge_safe"
            android:src="@drawable/ic_mic"
            android:contentDescription="Toggle Voice SOS Listening" />

        <!-- Quick SOS Header Action -->
        <Button
            android:id="@+id/btn_header_quick_sos"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/badge_critical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="🚨 SOS"
            android:textColor="@color/risk_critical"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Content Container -->
    <FrameLayout
        android:id="@+id/fl_content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/bg_dark"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:itemRippleColor="@color/primary_glow"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>
