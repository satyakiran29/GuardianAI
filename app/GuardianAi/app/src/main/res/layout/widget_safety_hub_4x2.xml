<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_safety_hub_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Left Side: Safety Status, Timeline & Action Buttons -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SAFETY STATUS"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_widget_zone_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="You are in\nSafe Zone"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="1dp" />

                <TextView
                    android:id="@+id/tv_widget_risk_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Risk Level: Low"
                    android:textColor="@color/primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/iv_widget_shield_badge"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_check"
                android:background="@drawable/badge_safe"
                android:padding="6dp" />
        </LinearLayout>

        <!-- 24H Safety Timeline Bar Wave Graphic -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:layout_marginEnd="1.5dp" android:background="#10B981" />
                <View android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1" android:layout_marginEnd="1.5dp" android:background="#10B981" />
                <View android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="1.5dp" android:background="#10B981" />
                <View android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1" android:layout_marginEnd="1.5dp" android:background="#10B981" />
                <View android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" android:layout_marginEnd="1.5dp" android:background="#10B981" />
                <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:layout_marginEnd="1.5dp" android:background="#10B981" />
                <View android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="1.5dp" android:background="#10B981" />
                <View android:layout_width="0dp" android:layout_height="9dp" android:layout_weight="1" android:layout_marginEnd="1.5dp" android:background="#F59E0B" />
                <View android:layout_width="0dp" android:layout_height="7dp" android:layout_weight="1" android:layout_marginEnd="1.5dp" android:background="#10B981" />
                <View android:layout_width="0dp" android:layout_height="11dp" android:layout_weight="1" android:layout_marginEnd="1.5dp" android:background="#10B981" />
                <View android:layout_width="0dp" android:layout_height="13dp" android:layout_weight="1" android:layout_marginEnd="1.5dp" android:background="#10B981" />
                <View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:layout_marginEnd="1.5dp" android:background="#10B981" />
                <View android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1" android:layout_marginEnd="1.5dp" android:background="#10B981" />
                <View android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1" android:background="#10B981" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="00:00"
                    android:textColor="@color/text_muted"
                    android:textSize="8sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24:00"
                    android:textColor="@color/text_muted"
                    android:textSize="8sp" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 4 Quick Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 1. Smart SOS -->
            <LinearLayout
                android:id="@+id/btn_widget_hub_sos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/widget_icon_sos_bg"
                    android:padding="7dp"
                    android:src="@drawable/ic_nav_sos" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Smart\nSOS"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 2. Live Location -->
            <LinearLayout
                android:id="@+id/btn_widget_hub_location"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/widget_icon_loc_bg"
                    android:padding="7dp"
                    android:src="@drawable/ic_location" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Live\nLocation"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 3. Safe Route -->
            <LinearLayout
                android:id="@+id/btn_widget_hub_route"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/widget_icon_route_bg"
                    android:padding="7dp"
                    android:src="@drawable/ic_nav_map" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Safe\nRoute"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 4. My Contacts -->
            <LinearLayout
                android:id="@+id/btn_widget_hub_contacts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/widget_icon_contacts_bg"
                    android:padding="7dp"
                    android:src="@drawable/ic_call" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="My\nContacts"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Vertical Divider -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:background="#1E2E47" />

    <!-- Right Side: Heatmap, Compass, Weather & Time -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="NEARBY RISK HEATMAP"
                android:textColor="@color/text_muted"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧭 N"
                android:textColor="@color/secondary_light"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Mini Heatmap Simulated Area -->
        <FrameLayout
            android:id="@+id/layout_widget_heatmap_container"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/widget_bg_subcard"
            android:padding="4dp">

            <!-- Heatmap Nodes -->
            <ImageView
                android:id="@+id/iv_widget_heatmap_graphic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_nav_map"
                android:tint="#182A44" />

            <!-- Green Node -->
            <View
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/badge_safe" />

            <!-- Amber Node -->
            <View
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="8dp"
                android:background="@drawable/badge_moderate" />

            <!-- Red High Risk Node -->
            <View
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="top|end"
                android:layout_marginEnd="18dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/badge_critical" />

            <!-- User Live Blue Dot -->
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_avatar_circle"
                android:src="@drawable/ic_check"
                android:tint="@color/secondary_light"
                android:padding="2dp" />
        </FrameLayout>

        <!-- Legend Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View android:layout_width="6dp" android:layout_height="6dp" android:background="#10B981" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:text="Low" android:textColor="@color/text_muted" android:textSize="8sp" />

            <View android:layout_width="6dp" android:layout_height="6dp" android:layout_marginStart="8dp" android:background="#F59E0B" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:text="Moderate" android:textColor="@color/text_muted" android:textSize="8sp" />

            <View android:layout_width="6dp" android:layout_height="6dp" android:layout_marginStart="8dp" android:background="#EF4444" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:text="High" android:textColor="@color/text_muted" android:textSize="8sp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Weather & Time Bottom Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Weather -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_widget_weather" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_widget_weather_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="28°C"
                        android:textColor="@color/text_primary"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_widget_weather_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Light Rain"
                        android:textColor="@color/text_muted"
                        android:textSize="8sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Time -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_widget_time" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_widget_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10:30 AM"
                        android:textColor="@color/text_primary"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_widget_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thu, 22 May"
                        android:textColor="@color/text_muted"
                        android:textSize="8sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
