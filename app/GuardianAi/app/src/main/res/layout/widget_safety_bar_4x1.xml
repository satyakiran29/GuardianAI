<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_safety_bar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- 1. Shield Logo -->
    <ImageView
        android:id="@+id/iv_bar_shield"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:src="@drawable/widget_shield_pink" />

    <!-- 2. Safety Score -->
    <LinearLayout
        android:id="@+id/layout_bar_score"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1.3"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Safety Score"
            android:textColor="@color/text_muted"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_bar_score_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="82"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginBottom="2dp"
                android:text="/100"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_bar_score_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You are doing great!"
            android:textColor="@color/secondary_light"
            android:textSize="8.5sp"
            android:singleLine="true" />
    </LinearLayout>

    <!-- 3. Risk Level Card -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_bg_subcard"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_check"
            android:tint="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Risk Level"
            android:textColor="@color/text_muted"
            android:textSize="8sp" />

        <TextView
            android:id="@+id/tv_bar_risk_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Low"
            android:textColor="@color/primary"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 4. People Around Card -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_bg_subcard"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_widget_people" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="People Around"
            android:textColor="@color/text_muted"
            android:textSize="8sp" />

        <TextView
            android:id="@+id/tv_bar_people_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="23 Nearby"
            android:textColor="@color/text_primary"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 5. Safe Places Card -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_bg_subcard"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_widget_safeplace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Safe Places"
            android:textColor="@color/text_muted"
            android:textSize="8sp" />

        <TextView
            android:id="@+id/tv_bar_safe_places_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5 Nearby"
            android:textColor="@color/text_primary"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 6. Quote Card -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1.1"
        android:background="@drawable/widget_bg_subcard"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stay aware"
            android:textColor="@color/text_primary"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stay safe"
            android:textColor="@color/text_primary"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="❤️"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
