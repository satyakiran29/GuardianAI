<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_sos_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_shield_logo" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="GUARDIAN AI"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⋮"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Big Center SOS Button -->
    <LinearLayout
        android:id="@+id/btn_widget_trigger_sos"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="@drawable/widget_sos_btn_red"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SOS"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TAP TO ALERT"
            android:textColor="#EEFFFFFF"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Contact Dispatch Target Card -->
    <LinearLayout
        android:id="@+id/btn_widget_sos_contacts_open"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_bg_subcard"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tv_widget_alert_target_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alert will be sent to"
            android:textColor="@color/text_muted"
            android:textSize="9sp" />

        <!-- Avatar Icons Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/widget_avatar_circle"
                android:gravity="center"
                android:text="👮"
                android:textSize="10sp" />

            <TextView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="-4dp"
                android:background="@drawable/widget_avatar_circle"
                android:gravity="center"
                android:text="👩"
                android:textSize="10sp" />

            <TextView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="-4dp"
                android:background="@drawable/widget_avatar_circle"
                android:gravity="center"
                android:text="👨"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_widget_contacts_more_count"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="-4dp"
                android:background="@drawable/badge_safe"
                android:gravity="center"
                android:text="+2"
                android:textColor="@color/primary"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Location Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_location"
            android:tint="@color/risk_critical" />

        <TextView
            android:id="@+id/tv_widget_sos_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Current: 12.9784° N, 77.6408° E"
            android:textColor="@color/text_secondary"
            android:textSize="8.5sp"
            android:singleLine="true" />
    </LinearLayout>

</LinearLayout>
