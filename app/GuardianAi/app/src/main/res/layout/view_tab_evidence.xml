<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_darkest"
    android:padding="16dp">

    <!-- Header Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_glass_bg"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_nav_vault" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Emergency Evidence Vault"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Geo-tagged photo, video &amp; audio recording"
                    android:textColor="@color/text_muted"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_vault_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_safe"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="3 ITEMS"
                android:textColor="@color/primary"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Capture Trigger Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_capture_photo"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/btn_primary_gradient"
                android:text="📸 Photo"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_capture_video"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/btn_secondary_outline"
                android:text="📹 Video"
                android:textAllCaps="false"
                android:textColor="@color/secondary"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_record_audio"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/btn_secondary_outline"
                android:text="🎙️ Voice Memo"
                android:textAllCaps="false"
                android:textColor="@color/risk_moderate"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Audio Recording Active Indicator -->
        <LinearLayout
            android:id="@+id/layout_audio_recording_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/badge_critical"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_mic_active" />

            <TextView
                android:id="@+id/tv_audio_timer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Recording Voice Evidence: 00:06"
                android:textColor="@color/risk_critical"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_stop_audio_record"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/btn_primary_gradient"
                android:text="Stop &amp; Save"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="SAVED EVIDENCE LOGS"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <!-- Evidence RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_evidence_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp" />

</LinearLayout>
