<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_glass_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_shield_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Guardian AI Widgets"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Women &amp; Child Safety Widgets • Designed for Anify ✨"
                    android:textColor="@color/secondary_light"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="4 Premium Widgets Available on your Android Home Screen:"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <!-- 1. 4x2 Safety Hub -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#0A0F1D"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. 4x2 Comprehensive Safety Hub Widget"
                android:textColor="@color/primary_light"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="• Real-time Safe Zone Status &amp; 24h Risk Wave Timeline\n• Interactive Nearby Risk Heatmap with Compass\n• 4 Quick Actions: Smart SOS, Live Location, Safe Route, Contacts\n• Live Weather &amp; Clock integration"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <!-- 2. 2x2 Quick SOS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#0A0F1D"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. 2x2 Quick Emergency SOS Widget"
                android:textColor="@color/risk_critical"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="• Central Pulsing Glowing SOS Button (1-Tap Dispatch)\n• Target Emergency Contact Avatars badge\n• Live GPS Coordinates watermark"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <!-- 3. 4x1 Safety Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#0A0F1D"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. 4x1 Horizontal Safety Bar Widget"
                android:textColor="@color/secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="• Safety Score (82/100) + Risk Level badge\n• People Around &amp; Safe Places counter\n• 'Stay aware, Stay safe ❤️' safety quote"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <!-- 4. 1x1 Glance -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#0A0F1D"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4. 1x1 Compact Quick Glance Widget"
                android:textColor="@color/risk_moderate"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="• Compact 1-cell Risk Level &amp; Guardian AI Brand badge"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- How to Add Guide -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="💡 To add to your home screen: Long-press any empty space on your phone home screen -> Tap 'Widgets' -> Select 'GuardianAI' -> Drag your favorite widget!"
            android:textColor="@color/primary_light"
            android:textSize="11.5sp"
            android:lineSpacingExtra="2dp" />

        <Button
            android:id="@+id/btn_close_widget_showcase"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/btn_primary_gradient"
            android:text="Got It!"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
